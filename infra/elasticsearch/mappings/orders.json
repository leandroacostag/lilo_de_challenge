{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "product_title_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "english_stop", "english_stemmer"]
        }
      },
      "filter": {
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        },
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "order_id": {
        "type": "keyword"
      },
      "user_id": {
        "type": "keyword"
      },
      "cart": {
        "properties": {
          "items": {
            "type": "nested",
            "properties": {
              "product_id": {
                "type": "keyword"
              },
              "title": {
                "type": "text",
                "analyzer": "product_title_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                }
              },
              "price": {
                "type": "float"
              },
              "quantity": {
                "type": "integer"
              }
            }
          }
        }
      },
      "delivery_mode": {
        "type": "keyword"
      },
      "date": {
        "type": "date"
      },
      "total_items": {
        "type": "integer"
      },
      "total_amount": {
        "type": "float"
      }
    }
  }
}

